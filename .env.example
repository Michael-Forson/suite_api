# suite_admin page that handles both super-admin invitations and password
# resets. The API appends `token`, or substitutes `{{token}}` if the URL
# contains it. Invites and resets are 500s without this.
SUPER_ADMIN_PASSWORD_SETUP_URL=http://localhost:3200/set-password

