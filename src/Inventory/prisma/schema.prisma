// Inventory app database — separate from the core DB.
//
// Users, organizations, staff and branches live in the core database. Every
// `organizationId` / `branchId` / `createdBy` / `approvedBy` / `referenceId`
// column here is a *logical* reference to that database (or to another app): an
// indexed UUID with no foreign key, because FKs cannot cross databases.
//
// `branchId` in particular is not FK-protected, so two rules stand in for what
// `onDelete: Restrict` used to guarantee: core soft-deletes branches and never
// hard-deletes them, and every write path here resolves and validates its branch
// through `branch.service.ts` before posting.
//
// See `suite_api/inventory_schema (1).md` for the design rationale.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma-inventory"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MovementType {
  IN
  OUT
}

/// Where a movement came from. Documents behind PURCHASE and SALE live in other
/// apps, so `referenceId` is a logical id, not an FK.
enum MovementReferenceType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
  OPENING
  MANUAL
}

/// PHYSICAL is somewhere you could walk to; VIRTUAL is a bucket that holds
/// stock without being a place — an online reserve, a damaged pile, quarantine.
/// The distinction is for the UI and for reports; the ledger treats both alike.
enum StockLocationType {
  PHYSICAL
  VIRTUAL
}

enum StockAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Org-level settings
// ---------------------------------------------------------------------------

/// One row per organization — the home for inventory-only defaults.
///
/// The location label ("Branch" / "Store" / "Warehouse") deliberately does *not*
/// live here: it is org-wide vocabulary that POS and Attendance must agree with,
/// so it sits on `organizations` in the core DB.
model InventorySettings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  /// Off by default. The lot columns exist on the ledger from day one so that
  /// turning this on is a flag flip rather than a backfill of an immutable
  /// table — but while it is false every `lotId` stays null and the service
  /// layer rejects any caller that supplies one. See `StockLot`.
  lotTracking    Boolean  @default(false) @map("lot_tracking")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("inventory_settings")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Seeded per org from a default set; `isSystem` marks the seeded rows. No
/// conversion model — if "buy by the box, stock by the each" is ever needed,
/// `baseUnitId` (self-ref) + `factor` can be added here without touching the
/// ledger.
model Unit {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  symbol         String    @db.VarChar(20)
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  products  Product[]
  movements InventoryMovement[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("units")
}

model Category {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  parentCategoryId String?   @map("parent_category_id") @db.Uuid
  name             String    @db.VarChar(150)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([organizationId])
  @@index([parentCategoryId])
  @@index([deletedAt])
  @@map("categories")
}

model Brand {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  products Product[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("brands")
}

/// The axis of variation: "Color", "Size".
model Attribute {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  values            AttributeValue[]
  productAttributes ProductAttribute[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("attributes")
}

/// A point on the axis: "Red", "Large".
model AttributeValue {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  attributeId    String    @map("attribute_id") @db.Uuid
  value          String    @db.VarChar(100)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  attribute       Attribute               @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  variantAssigned VariantAttributeValue[]

  @@index([organizationId])
  @@index([attributeId])
  @@index([deletedAt])
  @@map("attribute_values")
}

/// The template — shared information only. `sku`, `barcode`, prices and reorder
/// levels live on the variant, never here.
model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  brandId        String?       @map("brand_id") @db.Uuid
  /// The stocking unit.
  baseUnitId     String        @map("base_unit_id") @db.Uuid
  name           String        @db.VarChar(200)
  description    String?       @db.Text
  /// False for services and other non-stock items.
  trackInventory Boolean       @default(true) @map("track_inventory")
  status         ProductStatus @default(ACTIVE)
  /// Logical ref → core DB user.
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand      Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUnit   Unit               @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  attributes ProductAttribute[]
  variants   ProductVariant[]
  images     ProductImage[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([baseUnitId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

/// Which attributes this product varies on.
model ProductAttribute {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String @map("product_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@map("product_attributes")
}

/// The actual stock-keeping unit. Every product has at least one; a "simple"
/// product has a single `isDefault` variant carrying its SKU and prices. All
/// stock references a variant, never a product.
model ProductVariant {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from the product for tenant-scoped queries.
  organizationId String        @map("organization_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  name           String        @db.VarChar(250)
  sku            String        @db.VarChar(100)
  barcode        String?       @db.VarChar(100)
  /// Standard/default cost, used to prefill new documents. NOT the valuation
  /// source — real COGS comes from `InventoryMovement.unitCost`.
  costPrice      Decimal       @default(0) @map("cost_price") @db.Decimal(18, 4)
  sellingPrice   Decimal       @default(0) @map("selling_price") @db.Decimal(18, 4)
  status         VariantStatus @default(ACTIVE)
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  images          ProductImage[]
  inventory       Inventory[]
  reorderRules    ReorderRule[]
  movements       InventoryMovement[]
  adjustmentItems StockAdjustmentItem[]
  transferItems   StockTransferItem[]
  lots            StockLot[]

  // Soft-deleted rows keep occupying their SKU/barcode. Free one by renaming it
  // on delete (e.g. suffix the id) rather than relaxing these constraints.
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([productId])
  @@index([status])
  @@index([deletedAt])
  @@map("product_variants")
}

/// Links a variant to its Red + L.
model VariantAttributeValue {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Null = a product-level image; set = specific to one variant.
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Stock levels
//
// The stocking place itself — `Branch` — lives in the core database, because a
// branch is a fact about the business that POS, Attendance and Accounting all
// need, not something the inventory app owns. Everything below holds `branchId`
// as a logical reference to it.
// ---------------------------------------------------------------------------

/// Where stock actually sits. A branch is a building; this is a place inside it
/// — shop floor, back store, damaged pile, online reserve.
///
/// Unlike `branchId`, this is *not* a logical reference to the core database. A
/// branch is a fact the whole business shares: it has an address and a code,
/// staff clock in against it, and POS and Accounting both read it. A storage
/// location is inventory's vocabulary alone — nothing outside this app has an
/// opinion about which shelf something is on — so it lives here, with real
/// foreign keys.
///
/// That distinction is also why "the webshop" must be a location and never a
/// branch: modelling it as a branch would put a place nobody works at into
/// attendance rosters and the org chart.
///
/// Every branch has exactly one `isDefault` location, created on demand by
/// `location.service.ts` the first time that branch is used. A single-location
/// business never sees this model — its stock lands in the default and its UI
/// need not mention locations at all.
model StockLocation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  /// Logical ref → core DB branch, validated through `branch.service.ts`.
  branchId       String            @map("branch_id") @db.Uuid
  name           String            @db.VarChar(150)
  code           String            @db.VarChar(50)
  type           StockLocationType @default(PHYSICAL)
  isDefault      Boolean           @default(false) @map("is_default")
  /// Whether stock here counts toward what can be sold. False for damaged and
  /// quarantine, so writing stock off is a move rather than a deletion.
  isSellable     Boolean           @default(true) @map("is_sellable")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  inventory      Inventory[]
  movements      InventoryMovement[]
  adjustments    StockAdjustment[]
  transfersFrom  StockTransfer[]     @relation("TransferFrom")
  transfersTo    StockTransfer[]     @relation("TransferTo")

  // One `isDefault` location per branch is application-enforced, the same way
  // core enforces one default branch per org — Prisma cannot express the partial
  // unique index it wants.
  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("stock_locations")
}

/// One received batch of one variant: a lot number and, for dated goods, an
/// expiry.
///
/// Lots are the one dimension that could not be deferred. Every other missing
/// column can be added later and backfilled; this one lands on
/// `InventoryMovement`, which is append-only, so a ledger written without it
/// can never be told which batch its rows moved. The columns therefore exist
/// from the first migration and stay null until `InventorySettings.lotTracking`
/// is turned on — no UI, no FEFO picking, no expiry reports at launch, just the
/// shape reserved.
///
/// A lot is not scoped to a branch: the same batch can sit in several branches
/// at once, and `Inventory` keys on variant + branch + lot to say how much of it
/// is where.
model StockLot {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  /// The supplier's batch number as printed. Unique per variant.
  lotNumber      String    @map("lot_number") @db.VarChar(100)
  /// Null for lots that are tracked for traceability but do not expire.
  expiryDate     DateTime? @map("expiry_date") @db.Date
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventory       Inventory[]
  movements       InventoryMovement[]
  adjustmentItems StockAdjustmentItem[]
  transferItems   StockTransferItem[]

  @@unique([variantId, lotNumber])
  @@index([organizationId])
  @@index([variantId])
  // Drives FEFO picking and expiry reporting once lot tracking is on.
  @@index([expiryDate])
  @@map("stock_lots")
}

/// Reorder points are per branch, not global.
model ReorderRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  /// Trigger point.
  reorderLevel    Decimal  @default(0) @map("reorder_level") @db.Decimal(18, 4)
  /// Target top-up quantity.
  reorderQuantity Decimal  @default(0) @map("reorder_quantity") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, branchId])
  @@index([organizationId])
  @@index([branchId])
  @@map("reorder_rules")
}

/// On-hand cache, keyed by variant + location + lot. Derived by summing
/// `InventoryMovement`; written in the same transaction as the movement it
/// follows. Never the source of truth — rebuild it from the ledger if they
/// diverge.
///
/// This row is also the concurrency anchor for the whole ledger. Two movements
/// for the same key that both read `quantity` before either writes would compute
/// the same `balanceAfter`, and the ledger is append-only, so the wrong number
/// could not be edited out afterwards. `postMovement` therefore never reads then
/// writes: it takes the row's lock with a single atomic upsert and derives
/// `balanceAfter` from what that statement returns. See `movement.service.ts`.
model Inventory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  /// The real stocking key. Every branch has a default location, so a business
  /// that never configures one still lands here.
  locationId       String   @map("location_id") @db.Uuid
  /// Denormalized from the location. "Stock by branch" is the report everyone
  /// runs, and this keeps it off a join on the hot path. Derived, never
  /// authoritative — the location owns the truth.
  branchId         String   @map("branch_id") @db.Uuid
  /// Null until `InventorySettings.lotTracking` is on — see `StockLot`.
  lotId            String?  @map("lot_id") @db.Uuid
  /// Physical on hand.
  quantity         Decimal  @default(0) @db.Decimal(18, 4)
  /// Committed to sales orders.
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 4)
  /// On open POs / inbound in-transit.
  incomingQuantity Decimal  @default(0) @map("incoming_quantity") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lot      StockLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  // `available = quantity - reservedQuantity` is computed at read time, never
  // stored — and sums only locations with `isSellable`, so damaged and
  // quarantined stock drops out of availability without leaving the books.
  //
  // Prisma emits this as a plain unique index, under which Postgres treats two
  // NULL `lot_id`s as distinct — untracked stock would get a new row per
  // movement and the upsert in `postMovement` would never find its conflict
  // target. `sql/inventory-constraints.sql` replaces it with the same index
  // declared `NULLS NOT DISTINCT` (Postgres 15+). Do not skip that step.
  @@unique([variantId, locationId, lotId])
  @@index([organizationId])
  @@index([locationId])
  @@index([branchId])
  @@index([lotId])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// The ledger — append-only source of truth
// ---------------------------------------------------------------------------

/// Immutable. No `updatedAt`, no `deletedAt`: a correction is a new reversing
/// row, never an edit or a delete.
///
/// Immutability is what makes the nullable `lotId` and `unitId` below worth
/// their weight: every other table here can gain a column and be backfilled,
/// this one cannot. A row written without them is permanently unattributable.
model InventoryMovement {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  variantId      String                @map("variant_id") @db.Uuid
  /// Where the stock actually moved. Like `unitId` and `lotId`, this could not
  /// be deferred: a row written without it can never be told which shelf,
  /// reserve or quarantine pile it happened at.
  locationId     String                @map("location_id") @db.Uuid
  /// Denormalized from the location, for branch-level history without a join.
  branchId       String                @map("branch_id") @db.Uuid
  /// Null until `InventorySettings.lotTracking` is on — see `StockLot`.
  lotId          String?               @map("lot_id") @db.Uuid
  /// A transfer is an OUT row plus an IN row.
  type           MovementType
  /// Always positive; direction comes from `type`.
  quantity       Decimal               @db.Decimal(18, 4)
  /// The unit `quantity` is expressed in. Always the product's `baseUnitId`
  /// today — `postMovement` refuses anything else — and stamped here anyway so
  /// that claim is a fact in the row rather than a promise about the code that
  /// wrote it. Without it, the day someone receives "1 box of 12" as
  /// `quantity = 1`, nothing in the ledger distinguishes that row from one box's
  /// worth of eaches, and it is not editable. Null on rows written before this
  /// column existed; there are none.
  unitId         String?               @map("unit_id") @db.Uuid
  /// Cost at the time of the movement. Captured here because it is impossible
  /// to reconstruct later — this is what makes FIFO / weighted-average possible.
  unitCost       Decimal               @default(0) @map("unit_cost") @db.Decimal(18, 4)
  /// On-hand for this variant+location+lot after this row. Assigned by the
  /// atomic upsert in `postMovement`, never by a read-then-write.
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(18, 4)
  referenceType  MovementReferenceType @map("reference_type")
  /// Source document id — may live in another database, so it is a logical ref.
  referenceId    String?               @map("reference_id") @db.Uuid
  reason         String?               @db.Text
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lot      StockLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  unit     Unit?          @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  // The running-balance read: one variant's history at one location, in order.
  @@index([variantId, locationId, createdAt])
  @@index([variantId, branchId, createdAt])
  @@index([branchId])
  @@index([referenceType, referenceId])
  @@index([lotId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Operations — produce movements when completed
// ---------------------------------------------------------------------------

model StockAdjustment {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  /// "ADJ-0001" — unique per org.
  number         String                @db.VarChar(50)
  /// You count a location, not a building. The branch is reached through it —
  /// unlike the ledger, a document is low-volume and mutable, so denormalizing
  /// `branchId` here would only invite drift.
  locationId     String                @map("location_id") @db.Uuid
  reason         String?               @db.Text
  status         StockAdjustmentStatus @default(DRAFT)
  notes          String?               @db.Text
  createdBy      String?               @map("created_by") @db.Uuid
  approvedBy     String?               @map("approved_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  completedAt    DateTime?             @map("completed_at")
  deletedAt      DateTime?             @map("deleted_at")

  items    StockAdjustmentItem[]
  location StockLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([locationId])
  @@index([status])
  @@index([deletedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustmentId   String  @map("adjustment_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  /// Null until `InventorySettings.lotTracking` is on. Carried through to the
  /// movement this item posts, so a count is against one batch.
  lotId          String? @map("lot_id") @db.Uuid
  /// Snapshot of on-hand at the time of the count.
  systemQuantity Decimal @map("system_quantity") @db.Decimal(18, 4)
  actualQuantity Decimal @map("actual_quantity") @db.Decimal(18, 4)
  /// `actual - system`, stored as a snapshot so the counted result survives
  /// later movements.
  difference     Decimal @db.Decimal(18, 4)
  /// Used to value the difference.
  unitCost       Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lot        StockLot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([variantId])
  @@index([lotId])
  @@map("stock_adjustment_items")
}

model StockTransfer {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  /// "TRF-0001" — unique per org.
  number         String              @db.VarChar(50)
  /// Locations, not branches — which makes moving stock from the shop floor to
  /// the online reserve the same mechanism as moving it between buildings,
  /// rather than a second feature.
  fromLocationId String              @map("from_location_id") @db.Uuid
  toLocationId   String              @map("to_location_id") @db.Uuid
  status         StockTransferStatus @default(DRAFT)
  notes          String?             @db.Text
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  shippedAt      DateTime?           @map("shipped_at")
  receivedAt     DateTime?           @map("received_at")
  deletedAt      DateTime?           @map("deleted_at")

  items        StockTransferItem[]
  fromLocation StockLocation      @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   StockLocation      @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([deletedAt])
  @@map("stock_transfers")
}

/// `shippedQuantity` vs `receivedQuantity` is what keeps in-transit stock and
/// partial receipts visible — goods that left the source but have not arrived
/// are not lost.
model StockTransferItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId       String  @map("transfer_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  /// Null until `InventorySettings.lotTracking` is on. A lot is not scoped to a
  /// branch, so the same id travels on both the OUT and the IN movement.
  lotId            String? @map("lot_id") @db.Uuid
  /// Requested.
  quantity         Decimal @db.Decimal(18, 4)
  /// Left the source branch.
  shippedQuantity  Decimal @default(0) @map("shipped_quantity") @db.Decimal(18, 4)
  /// Arrived at the destination branch.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 4)
  /// Carries cost across the move.
  unitCost         Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lot      StockLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([variantId])
  @@index([lotId])
  @@map("stock_transfer_items")
}
