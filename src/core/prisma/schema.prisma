generator client {
  provider            = "prisma-client"
  output              = "../src/core/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
}

enum CodeType {
  ACTIVATION
  RESET
  LOGIN
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationAudience {
  USER
  ALL
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum AppStatus {
  ACTIVE
  DISABLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationAppStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum OrganizationAppAccessType {
  FREE
  TRIAL
  PAID
  INTERNAL
}

enum BillingProvider {
  STRIPE
  PAYSTACK
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum AppPermissionStatus {
  ACTIVE
  DISABLED

  @@map("PermissionStatus")
}

enum MemberAppRoleStatus {
  ACTIVE
  DISABLED
}

enum SuperAdminStatus {
  ACTIVE
  DISABLED
  // Invited but has not set a password yet. Login and superAdminAuthenticate
  // both require ACTIVE, so an invited account cannot sign in or hold a session,
  // and it does not count toward the "at least one active super-admin" rule.
  INVITED
}

enum SuperAdminTokenType {
  INVITE
  PASSWORD_RESET
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model SuperAdmin {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName   String           @map("first_name") @db.VarChar(100)
  lastName    String           @map("last_name") @db.VarChar(100)
  email       String           @unique @db.VarChar(255)
  // Null between the invitation and the moment they set their own password.
  // Nobody is ever handed a password they did not choose.
  password    String?          @db.VarChar(255)
  status      SuperAdminStatus @default(ACTIVE)
  lastLoginAt DateTime?        @map("last_login_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tokens SuperAdminToken[]

  @@index([status])
  @@map("super_admins")
}

/// One row per outstanding invite or password-reset link. Both are the same
/// thing — a single-use, expiring capability to set a password — so they share a
/// table and differ by `type`, which is what decides the email and the wording
/// on the page.
model SuperAdminToken {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  superAdminId String              @map("super_admin_id") @db.Uuid
  type         SuperAdminTokenType
  token        String              @unique @db.VarChar(255)
  expiresAt    DateTime            @map("expires_at")
  usedAt       DateTime?           @map("used_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([expiresAt])
  @@map("super_admin_tokens")
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String?       @map("first_name") @db.VarChar(100)
  lastName        String?       @map("last_name") @db.VarChar(100)
  email           String?       @unique @db.VarChar(255)
  phone           String?       @unique @db.VarChar(20)
  googleId        String?       @unique @map("google_id") @db.VarChar(255)
  appleId         String?       @unique @map("apple_id") @db.VarChar(255)
  password        String?       @db.VarChar(255)
  avatarUrl       String?       @map("avatar_url") @db.VarChar(500)
  gender          Gender?
  dob             DateTime?     @db.Date
  authProvider    AuthProvider  @default(PHONE) @map("auth_provider")
  emailVerifiedAt DateTime?     @map("email_verified_at")
  phoneVerifiedAt DateTime?     @map("phone_verified_at")
  isActive        Boolean       @default(true) @map("is_active")
  status          AccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?     @map("last_login_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  notifications               Notification[]
  deviceTokens                DeviceToken[]
  transactions                Transaction[]
  ownedOrganizations          Organization[]           @relation("OrganizationOwner")
  organizationMemberships     OrganizationMember[]     @relation("OrganizationMemberUser")
  sentMemberInvitations       OrganizationMember[]     @relation("OrganizationMemberInviter")
  enabledOrganizationApps     OrganizationApp[]        @relation("OrganizationAppEnabledBy")
  disabledOrganizationApps    OrganizationApp[]        @relation("OrganizationAppDisabledBy")
  assignedMemberAppRoles      MemberAppRole[]          @relation("MemberAppRoleAssignedBy")
  sentOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationInviter")

  @@index([status])
  @@index([isActive, deletedAt])
  @@map("users")
}

model Organization {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String        @db.VarChar(150)
  slug                  String        @unique @db.VarChar(150)
  ownerId               String        @map("owner_id") @db.Uuid
  businessType          String?       @map("business_type") @db.VarChar(100)
  industry              String?       @db.VarChar(100)
  email                 String?       @db.VarChar(255)
  phone                 String?       @db.VarChar(20)
  logoUrl               String?       @map("logo_url") @db.VarChar(500)
  country               String?       @db.VarChar(100)
  city                  String?       @db.VarChar(100)
  address               String?       @db.Text
  status                AccountStatus @default(ACTIVE)
  /// What this org calls a `Branch` in its UI — "Branch", "Store", "Warehouse",
  /// "Location", or anything else. Org-wide vocabulary, not per-app: Inventory,
  /// POS and Attendance all read it so they agree on the term. The schema never
  /// changes regardless of the label chosen.
  locationLabelSingular String        @default("Branch") @map("location_label_singular") @db.VarChar(50)
  locationLabelPlural   String        @default("Branches") @map("location_label_plural") @db.VarChar(50)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  owner            User                          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          OrganizationMember[]
  apps             OrganizationApp[]
  invitations      OrganizationInvitation[]
  billingCustomers OrganizationBillingCustomer[]
  subscription     OrganizationSubscription?
  branches         Branch[]

  @@index([ownerId])
  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  organizationRole OrganizationRole @default(MEMBER) @map("organization_role")
  jobTitle         String?          @map("job_title") @db.VarChar(150)
  status           MemberStatus     @default(PENDING)
  invitedBy        String?          @map("invited_by") @db.Uuid
  joinedAt         DateTime?        @map("joined_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter      User?           @relation("OrganizationMemberInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  appRoles     MemberAppRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationRole])
  @@index([status])
  @@index([invitedBy])
  @@map("organization_members")
}

/// A physical place the business operates from. Core, not app-level: POS needs it
/// for where a sale rang up, Inventory for where stock sits, Attendance for where
/// staff clock in. One shared list, one id, no app owns it.
///
/// Every organization has at least one — a default branch is created in the same
/// transaction as the organization itself (see `createOrganization`), so no app
/// ever has to handle an org with zero branches. Single-branch orgs simply never
/// see the concept in their UI.
///
/// Never hard-deleted. Other apps' databases hold `branchId` as a logical
/// reference with no foreign key (you cannot FK across databases), so the
/// `deletedAt` soft delete is the only thing keeping those references valid.
model Branch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(150)
  code           String       @db.VarChar(50)
  /// Address / geographic location text.
  location       String?      @db.Text
  isDefault      Boolean      @default(false) @map("is_default")
  status         BranchStatus @default(ACTIVE)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Exactly one default per org is enforced in application code — Prisma cannot
  // express the partial unique index this really wants:
  //   CREATE UNIQUE INDEX ... ON branches (organization_id)
  //     WHERE is_default AND deleted_at IS NULL;
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("branches")
}

model App {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(150)
  key         String    @unique @db.VarChar(100)
  description String?   @db.Text
  /// Object key in the public bucket, not a URL — the endpoint is deployment
  /// config, so it is composed at read time by `publicUrl`. Legacy rows may
  /// still hold an absolute URL; that helper passes those through untouched.
  iconKey     String?   @map("icon_key") @db.VarChar(500)
  appUrl      String?   @map("app_url") @db.VarChar(500)
  status      AppStatus @default(DISABLED)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organizationApps  OrganizationApp[]
  appPermissions    AppPermission[]
  appRoles          AppRole[]
  memberAppRoles    MemberAppRole[]
  planSubscriptions SubscriptionPlanApp[]

  @@index([status])
  @@map("apps")
}

model OrganizationApp {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  appId          String                    @map("app_id") @db.Uuid
  status         OrganizationAppStatus     @default(ACTIVE)
  accessType     OrganizationAppAccessType @default(FREE) @map("access_type")
  enabledBy      String?                   @map("enabled_by") @db.Uuid
  enabledAt      DateTime                  @default(now()) @map("enabled_at")
  disabledBy     String?                   @map("disabled_by") @db.Uuid
  disabledAt     DateTime?                 @map("disabled_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  enabler      User?        @relation("OrganizationAppEnabledBy", fields: [enabledBy], references: [id], onDelete: SetNull)
  disabler     User?        @relation("OrganizationAppDisabledBy", fields: [disabledBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, appId])
  @@index([appId])
  @@index([status])
  @@index([accessType])
  @@index([enabledBy])
  @@index([disabledBy])
  @@map("organization_apps")
}

model AppPermission {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId              String              @map("app_id") @db.Uuid
  key                String              @db.VarChar(150)
  label              String              @db.VarChar(150)
  description        String?             @db.Text
  category           String?             @db.VarChar(100)
  isSystemPermission Boolean             @default(true) @map("is_system_permission")
  status             AppPermissionStatus @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  app                App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  appRolePermissions AppRolePermission[]

  @@unique([appId, key])
  @@index([category])
  @@index([isSystemPermission])
  @@index([status])
  @@map("permissions")
}

model AppRole {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId       String     @map("app_id") @db.Uuid
  key         String     @db.VarChar(100)
  name        String     @db.VarChar(150)
  description String?    @db.Text
  isDefault   Boolean    @default(false) @map("is_default")
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  app                App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  appRolePermissions AppRolePermission[]
  memberAppRoles     MemberAppRole[]

  @@unique([appId, key])
  @@unique([appId, name])
  @@index([status])
  @@index([isDefault])
  @@map("app_roles")
}

model AppRolePermission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appRoleId       String   @map("app_role_id") @db.Uuid
  appPermissionId String   @map("permission_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  appRole       AppRole       @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  appPermission AppPermission @relation(fields: [appPermissionId], references: [id], onDelete: Cascade)

  @@unique([appRoleId, appPermissionId])
  @@index([appPermissionId])
  @@map("app_role_permissions")
}

model MemberAppRole {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationMemberId String              @map("organization_member_id") @db.Uuid
  appId                String              @map("app_id") @db.Uuid
  appRoleId            String              @map("app_role_id") @db.Uuid
  status               MemberAppRoleStatus @default(ACTIVE)
  assignedBy           String?             @map("assigned_by") @db.Uuid
  assignedAt           DateTime            @default(now()) @map("assigned_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  app                App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  appRole            AppRole            @relation(fields: [appRoleId], references: [id], onDelete: Restrict)
  assigner           User?              @relation("MemberAppRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([organizationMemberId, appId])
  @@index([appId])
  @@index([appRoleId])
  @@index([status])
  @@index([assignedBy])
  @@map("member_app_roles")
}

model OrganizationInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(255)
  invitedBy        String           @map("invited_by") @db.Uuid
  organizationRole OrganizationRole @default(MEMBER) @map("organization_role")
  status           InvitationStatus @default(PENDING)
  token            String           @unique @db.VarChar(255)
  expiresAt        DateTime         @map("expires_at")
  acceptedAt       DateTime?        @map("accepted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrganizationInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([invitedBy])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model SubscriptionPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  includedApps  SubscriptionPlanApp[]
  prices        SubscriptionPlanPrice[]
  subscriptions OrganizationSubscription[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_plans")
}

model SubscriptionPlanApp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  appId     String   @map("app_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  app  App              @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([planId, appId])
  @@index([appId])
  @@map("subscription_plan_apps")
}

model SubscriptionPlanPrice {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  provider        BillingProvider
  billingInterval BillingInterval @map("billing_interval")
  amount          Decimal?        @db.Decimal(10, 2)
  currency        String          @db.VarChar(3)
  providerPriceId String          @map("provider_price_id") @db.VarChar(255)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, provider, billingInterval])
  @@index([provider])
  @@index([billingInterval])
  @@index([isActive])
  @@map("subscription_plan_prices")
}

model OrganizationBillingCustomer {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  provider           BillingProvider
  providerCustomerId String          @map("provider_customer_id") @db.VarChar(255)
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@unique([provider, providerCustomerId])
  @@index([organizationId])
  @@map("organization_billing_customers")
}

model OrganizationSubscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  provider               BillingProvider
  billingInterval        BillingInterval    @map("billing_interval")
  status                 SubscriptionStatus @default(PENDING)
  providerCustomerId     String?            @map("provider_customer_id") @db.VarChar(255)
  providerSubscriptionId String?            @unique @map("provider_subscription_id") @db.VarChar(255)
  currentPeriodEnd       DateTime?          @map("current_period_end")
  providerResponse       Json?              @map("provider_response")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  checkoutSessions SubscriptionCheckoutSession[]

  @@index([planId])
  @@index([provider])
  @@index([status])
  @@map("organization_subscriptions")
}

model SubscriptionCheckoutSession {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  subscriptionId    String          @map("subscription_id") @db.Uuid
  provider          BillingProvider
  providerSessionId String          @unique @map("provider_session_id") @db.VarChar(255)
  checkoutUrl       String          @map("checkout_url") @db.VarChar(1000)
  status            String          @default("OPEN") @db.VarChar(50)
  checkoutSnapshot  Json?           @map("checkout_snapshot")
  providerResponse  Json?           @map("provider_response")
  createdBy         String?         @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([provider])
  @@index([createdBy])
  @@map("subscription_checkout_sessions")
}

model VerificationCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  code       String   @db.VarChar(6)
  type       CodeType @default(ACTIVATION)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier])
  @@map("verification_codes")
}

model VerificationAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier  String   @db.VarChar(255)
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  attempts    Int      @default(1)
  lastAttempt DateTime @default(now()) @map("last_attempt")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([identifier, ipAddress])
  @@index([identifier])
  @@index([ipAddress])
  @@index([lastAttempt])
  @@map("verification_attempts")
}

model Notification {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  targetAudience NotificationAudience? @map("target_audience")
  title          String                @db.VarChar(150)
  message        String                @db.Text
  type           String                @default("general") @db.VarChar(50)
  metadata       Json?
  readAt         DateTime?             @map("read_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetAudience, createdAt])
  @@map("notifications")
}

model Transaction {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  providerReference String            @unique @map("provider_reference") @db.VarChar(255)
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("GHS") @db.VarChar(3)
  status            TransactionStatus @default(PENDING)
  providerResponse  Json?             @map("provider_response")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([providerReference])
  @@index([status])
  @@map("transactions")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pushToken String   @map("push_token") @db.VarChar(255)
  platform  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([userId])
  @@index([pushToken])
  @@map("device_tokens")
}

model PlatformConfig {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceFeePercent Decimal  @default(0) @map("service_fee_percent") @db.Decimal(5, 2)
  serviceFeeCap     Decimal  @default(0) @map("service_fee_cap") @db.Decimal(10, 2)
  taxRate           Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model AppVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  app            String   @db.VarChar(50)
  platform       String   @db.VarChar(50)
  latestVersion  String   @map("latest_version") @db.VarChar(50)
  minimumVersion String   @map("minimum_version") @db.VarChar(50)
  storeUrl       String?  @map("store_url") @db.VarChar(500)
  updateMessage  String?  @map("update_message") @db.Text
  forceMessage   String?  @map("force_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([app, platform])
  @@map("app_versions")
}
